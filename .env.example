# Copia este archivo como .env en el servidor y rellénalo allí. Nunca lo subas al repositorio.

# Puerto del servidor
PORT=4240

# production marca la cookie de sesión como Secure: exige HTTPS
NODE_ENV=production

# Carpeta privada para la base de datos, comprobantes, fotos y recursos. Fuera de la carpeta pública.
LEGADO_DATA_DIR=/ruta/privada/legado-datos

# Cuenta del fundador: se crea o restablece al arrancar. Contraseña de 12 caracteres o más.
# Quítalas del entorno después del primer arranque si tu servidor lo permite.
FOUNDER_EMAIL=
FOUNDER_PASSWORD=

# Secreto con el que la pasarela firma sus confirmaciones (lo entrega el proveedor)
PAYMENT_WEBHOOK_SECRET=

# 1 activa la pasarela de pruebas (sandbox) fuera de la demostración. Nunca en producción.
PAYMENTS_SANDBOX=0
